# =============================================================================
# OCR Reader — environment configuration
#
# 1. Copy this file to ".env"          (cp .env.example .env)
# 2. Fill in OPENAI_API_KEY below
# 3. Never commit your real ".env" file — it is already listed in .gitignore
# =============================================================================

# --- Required -----------------------------------------------------------------
# Your OpenAI API key. Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here

# --- OpenAI model ---------------------------------------------------------------
# Any current OpenAI vision-capable model works. gpt-4.1-mini is a good
# balance of cost, speed and accuracy for OCR-style tasks.
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_OUTPUT_TOKENS=4000

# --- Application ------------------------------------------------------------------
APP_NAME=OCR Reader
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# --- Server -------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000

# --- Storage --------------------------------------------------------------------------
DATABASE_PATH=ocr_reader.db
LOG_DIR=logs
LOG_LEVEL=INFO

# --- Upload limits ------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=8
